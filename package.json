{
	"name": "nool",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"seed": "node scripts/reset-db.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"build:desktop": "vite build && node scripts/prep-desktop.js",
		"tauri": "tauri",
		"desktop:dev": "npm run build:desktop && tauri dev"
	},
	"devDependencies": {
		"@fontsource/hanken-grotesk": "^5.3.0",
		"@fontsource/space-grotesk": "^5.3.0",
		"@lucide/svelte": "^1.61.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tauri-apps/cli": "^2.12.4",
		"esbuild": "^0.28.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.13"
	}
}
