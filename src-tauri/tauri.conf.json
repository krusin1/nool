{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Nool",
	"version": "0.1.1",
	"identifier": "app.nool.desktop",
	"build": {
		"frontendDist": "../desktop/loading"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Productivity",
		"shortDescription": "A process log for makers",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"externalBin": [
			"binaries/nool-node"
		],
		"resources": {
			"../build/": "server/",
			"../mcp/dist/": "mcp/",
			"../figma-plugin/": "figma-plugin/"
		},
		"macOS": {
			"signingIdentity": "-"
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": [
					"nool"
				]
			}
		}
	}
}
